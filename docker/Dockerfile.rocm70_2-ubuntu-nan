# Start from the existing PyTorch ROCm image (same as working Dockerfile)
FROM ubuntu:22.04
#FROM rocm/pytorch-private:20251030_rocm_e2e_phantom_mi350_genai_nightly

# Switch to root to install packages
USER root

## Set ROCm version and build info
#ENV ROCM_VERSION=7.0.2
#ENV ROCM_BUILD=9428210
#ENV AMDGPU_BUILD=2247890

# Basic system setup
RUN apt-get update && apt-get install -y \
    wget \
    gnupg2 \
    software-properties-common \
    apt-utils \
    ca-certificates \
    curl \
    git \
    vim \
    build-essential \
    pkg-config \
    python3.10 \
    python3.10-dev \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Download and install amdgpu-install package for debian
RUN wget https://artifactory-cdn.amd.com:8443/artifactory/list/amdgpu-deb/amdgpu-install-internal_7.0.2.1-22.04-1_all.deb
RUN apt-get update && \
    apt-get install -y ca-certificates gnupg lsb-release sudo && \
    apt-get install -y ./amdgpu-install-internal_7.0.2.1-22.04-1_all.deb

# Update amdgpu-repo with specific builds (ROCm 7.0 Build #19, Jan 20, 2026)
RUN amdgpu-repo --amdgpu-build=2281818 --rocm-build=compute-rocm-rel-7.0-meta/19
RUN apt-get update && apt-get install -y \
    rocm-hip-sdk \
    rocm-libs \
    rocblas \
    hipblaslt \
    rocm-dev \
    && rm -rf /var/lib/apt/lists/*

