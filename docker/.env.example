# Docker Compose Environment Configuration
# Copy this file to .env and customize for your setup
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your settings
#   docker compose -f docker-compose.build.yaml up

# ==============================================================================
# DOCKERFILE SELECTION (Required)
# ==============================================================================
# Choose which Dockerfile to build from. Versions below are the ROCm userspace each
# image actually installs -- the `rocm70_9-1` / `rocm70_2` filenames encode an amdgpu
# installer revision, not a ROCm version, so don't read the version off the filename.
#
# - Dockerfile.rocm-latest             ROCm 7.14 / PyTorch 2.12 (latest production). DEFAULT --
#                                      use this unless you need an older stack specifically.
# - Dockerfile.rocm70_9-1              ROCm 7.2 / PyTorch 2.9.1
# - Dockerfile.rocm70_9-1-shampoo      ROCm 7.0 meta build #19, plus Shampoo optimizer
# - Dockerfile.rocm70_2-ubuntu-pytorch ROCm 7.0.2.1 build #17 on Ubuntu 22.04
# - Dockerfile.rocm70_2-ubuntu-nan     ROCm 7.0.2.1 build #17, plus NaN debugging tools
# - Dockerfile.rocm-ubuntu-ebpf        ROCm 7.2.0.1 build #5, plus eBPF tracing (bpftrace, bcc)
#
# The older pins are kept on purpose: for those images the ROCm version IS the
# experiment. Pick one only when reproducing a stack-specific bug.
#
DOCKERFILE=Dockerfile.rocm-latest

# ==============================================================================
# IMAGE NAME (Required)
# ==============================================================================
# The Docker image name:tag assigned to the built image.
# Recommended format: aorta:${variant}
#
# Examples:
#   IMAGE_NAME=aorta:rocm-latest
#   IMAGE_NAME=aorta:rocm70_9-1
#   IMAGE_NAME=aorta:therock-host-asan-pytorch
#
IMAGE_NAME=aorta:rocm-latest

# ==============================================================================
# CONTAINER NAME (Required)
# ==============================================================================
# Set a unique name for your container to avoid conflicts with other users
# Recommended format: ${USER}-${variant}-${experiment}
#
# Examples:
#   CONTAINER_NAME=username-rocm70-baseline
#   CONTAINER_NAME=training-overlap-debug-20260205
#   CONTAINER_NAME=shampoo-optimizer-test
#
CONTAINER_NAME=training-overlap-bugs-default

# ==============================================================================
# VOLUME MOUNTS
# ==============================================================================

# Path to the aorta workspace directory
# Default: .. (parent directory, assumes you're running from docker/ subdirectory)
#
# Examples:
#   AORTA_WORKSPACE=..                              (relative path)
#   AORTA_WORKSPACE=/apps/<username>/aorta          (absolute path)
#
AORTA_WORKSPACE=..

# Custom RCCL build (optional)
# Leave unset or commented to use the RCCL bundled in the Docker image.
# No need to edit the compose YAML when you don't use custom RCCL.
#
# To use a custom RCCL build:
#   1. Set RCCL_PATH to your RCCL build directory (e.g. /path/to/rccl)
#   2. Run with the RCCL override file:
#      docker compose -f docker-compose.build.yaml -f docker-compose.rccl.yaml up
#
# RCCL_PATH=/path/to/your/rccl

# Optional: Additional volume mounts
# If you set any of these, you must also uncomment the corresponding volume
# line(s) in docker-compose.build.yaml (search for EXTRA_MOUNT_SRC_1).
#
# EXTRA_MOUNT_SRC_1=/home/username/sdpa
# EXTRA_MOUNT_DST_1=/workspace/sdpa
#
# EXTRA_MOUNT_SRC_2=/apps/username/data
# EXTRA_MOUNT_DST_2=/data

# ==============================================================================
# ENVIRONMENT VARIABLES
# ==============================================================================

# AMD GPU driver variant for environment_info.json
# Possible values: "patched", "base", "mqd_vram", "default", or leave empty
# Default: empty (not set)
#
AMDGPU_DRIVER_VARIANT=

# ==============================================================================
# NOTES
# ==============================================================================
#
# 1. This .env file is git-ignored, so your personal configuration won't be
#    committed to the repository.
#
# 2. You can override any environment variable at runtime:
#    CONTAINER_NAME=my-test docker compose -f docker-compose.build.yaml up
#
# 3. To see which environment variables are being used:
#    docker compose -f docker-compose.build.yaml config
#
# 4. For quick setup, use the interactive script:
#    bash setup-env.sh
