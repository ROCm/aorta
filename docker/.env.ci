# CI-only Docker Compose environment (committed; unlike .env which is gitignored).
#
# Used by .github/workflows/gpu-tests.yml. Selects which Dockerfile, image tag
# and container name compose builds and runs for GPU CI on MI350 / gfx950
# hardware. It does NOT pin the base image: the digest that makes those runs
# reproducible lives in Dockerfile.ci-gpu, and this file carries no digest at
# all. Update it there when intentionally bumping the CI base image, resolving
# the new one with:
#   docker buildx imagetools inspect rocm/pytorch:rocm10.0_ubuntu26.04_py3.14_pytorch_release_2.13.0

DOCKERFILE=Dockerfile.ci-gpu
IMAGE_NAME=aorta:ci-gpu
CONTAINER_NAME=aorta-ci-gpu
AORTA_WORKSPACE=..
