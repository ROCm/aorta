# Env file for the non-gating "latest ROCm canary" lane (issue #382).
#
# Used by .github/workflows/latest-rocm-canary.yml, alongside the
# docker-compose.canary.yaml override that plumbs CANARY_BASE_IMAGE into the
# build. Unlike .env.ci this pins no digest: the whole point of the lane is that
# the base moves, and the workflow resolves `rocm/pytorch:latest` to a concrete
# digest at job start and records it with the results.
#
# Both lanes run on the same self-hosted MI350 runner, so they must not be able
# to disturb each other. That needs TWO things, and the container name alone is
# not enough:
#
#   * COMPOSE_PROJECT_NAME -- compose derives the project from the working
#     directory when it is unset, and both lanes invoke compose from `docker/`
#     with the same `torchenv` service. Both therefore landed in project
#     `docker`, so the canary's `up` could recreate the gate's service and its
#     `down -v` could delete it *and its volumes* mid-run. A distinct
#     CONTAINER_NAME does not prevent that: compose addresses the service, not
#     the container name.
#   * CONTAINER_NAME -- still distinct, so the two containers are also
#     distinguishable to `docker exec` / `docker ps` and to a human reading the
#     runner.

COMPOSE_PROJECT_NAME=aorta-canary
DOCKERFILE=Dockerfile.rocm-canary
IMAGE_NAME=aorta:rocm-canary
CONTAINER_NAME=aorta-rocm-canary
AORTA_WORKSPACE=..
